# Local-only vars for `wrangler dev`
# Copy this file to `.dev.vars` (do not commit `.dev.vars`).

# Use local Worker URL for local auth callbacks
APP_BASE_URL=http://localhost:7001
BETTER_AUTH_URL=http://localhost:7001

# Minimal required backend variables for local startup
DB_DIALECT=d1
BETTER_AUTH_SECRET=replace-with-a-random-32-char-min-secret

# D1 and R2 use the native bindings in wrangler.jsonc; no DATABASE_URL is needed.
# A built Wrangler preview with --local-upstream localhost rewrites Origin to
# http://localhost: use that origin for both auth URLs in that preview only.

# Optional placeholders (fill only if you use these features)
# STRIPE_SECRET_KEY=
# STRIPE_VIDEO_PRICE_ID=
# STRIPE_VIDEO_WEBHOOK_SECRET=
# OPENAI_API_KEY=

# AutoDL video generation: a token in the ComfyUI group (server-only secret).
# Create it at https://autodl.art/large-model/tokens. No Bearer prefix is added.
AUTODL_API_KEY=
# Optional override; must have the same image-and-prompt input schema.
AUTODL_VIDEO_WORKFLOW_ID=minimax_h3_lightx2v_v5

# Active Compshare provider; retain the AutoDL token for older saved orders.
COMPSHARE_API_KEY=
COMPSHARE_REFERENCE_VIDEO_URL=

# Required when testing R2 uploads through `wrangler dev`
R2_PUBLIC_URL=https://your-r2-custom-domain.example

# Enable when running affiliate E2E scenarios locally (disabled by default).
AFFILIATE_ENABLED=true
