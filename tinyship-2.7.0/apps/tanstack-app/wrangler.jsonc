{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-rapvideo",
	"account_id": "c686d583b6d595875de1b8b73462fe42",
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/worker.ts",
	"durable_objects": {
		"bindings": [{ "name": "PAID_VIDEO_RECOVERY", "class_name": "PaidVideoRecovery" }, { "name": "RAP_CREDIT_RECOVERY", "class_name": "RapCreditRecovery" }]
	},
	"migrations": [{ "tag": "paid-video-recovery-v1", "new_sqlite_classes": ["PaidVideoRecovery"] }, { "tag": "rap-credit-recovery-v1", "new_sqlite_classes": ["RapCreditRecovery"] }],
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	},
	"workers_dev": true,
	"routes": [
		{ "pattern": "ai-rapvideo.co", "custom_domain": true },
		{ "pattern": "www.ai-rapvideo.co", "custom_domain": true }
	],
	// Non-sensitive environment variables
	"vars": {
		"DB_DIALECT": "d1",
		"APP_BASE_URL": "https://ai-rapvideo.co",
		"BETTER_AUTH_URL": "https://ai-rapvideo.co",
		"VITE_STORAGE_PROVIDER": "r2",
		"R2_PUBLIC_URL": "https://media.ai-rapvideo.co"
	},
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "rumpelstiltskin-ai-uploads",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rumpelstiltskin-ai-db",
			"database_id": "76c8361b-6e97-4b4b-a77f-52dff0dd7126",
			"migrations_dir": "../../libs/database/drizzle-sqlite"
		}
	],
	// Database acceleration via Hyperdrive (requires `npx wrangler hyperdrive create`)
	// Uncomment after creating a Hyperdrive config:
	// "hyperdrive": [
	//   {
	//     "binding": "HYPERDRIVE",
	//     "id": "<your-hyperdrive-config-id>"
	//   }
	// ]
	// Cloudflare D1 database (alternative to Hyperdrive+PostgreSQL)
	// Set DB_DIALECT=d1 in vars to activate D1 mode.
	// Create a D1 database first: npx wrangler d1 create tinyship-db
	// Then uncomment and fill in the database_id:
	// "d1_databases": [
	//   {
	//     "binding": "DB",
	//     "database_name": "tinyship-db",
	//     "database_id": "<your-d1-database-id>"
	//   }
	// ]
}
